# PostgreSQL (Railway'de otomatik sağlanır)
DATABASE_URL=postgresql://user:password@localhost:5432/heqa

# tsoft kimlik bilgilerini şifrelemek için (Ayarlar ekranından girilen apiPass/apiToken)
ENCRYPTION_KEY=change-me-to-a-long-random-string

# apps/web ile bu servis arasındaki paylaşılan gizli anahtar
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Admin oturum token'larını (JWT) imzalamak için — apps/web/.env.local'daki ile AYNI olmalı
JWT_SECRET=change-me-to-a-long-random-string

# PDF üretimi için Playwright'ın ziyaret edeceği apps/web adresi (/catalog-print/:id)
WEB_URL=http://localhost:3000

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# İngilizce/Arapça katalog üretiminde eksik çevirileri (ürün adı/açıklama/kumaş) doldurmak için.
# Ücretsiz katmanın dakikalık istek sınırı MODELE GÖRE DEĞİŞİYOR — canlıda ölçüldü: düz "flash"
# modelleri (örn. gemini-3.6-flash) 5/dk, "lite" modelleri (varsayılan, aşağıya bkz.) 15/dk.
# Yine de çok ürünlü bir katalogda (ürün başına 4 alan) bu da aşılabilir — o durumda şablon
# Türkçe metne düşer (kırılmaz) ve eksik alanlar bir sonraki istekte kendiliğinden tamamlanır.
# Kalıcı/tam çözüm: Google AI Studio'da bu anahtar için faturalandırmayı aktif etmek — limit
# ~1000/dk'ya çıkar, maliyet metin çevirisi için ihmal edilebilir düzeyde.
GEMINI_API_KEY=
# Opsiyonel — belirtilmezse gemini-3.5-flash-lite kullanılır (ücretsiz katmanda 15/dk)
GEMINI_MODEL=
